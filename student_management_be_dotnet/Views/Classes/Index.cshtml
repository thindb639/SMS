@model ClassIndexViewModel
@{
    ViewData["Title"] = "Lớp học";
}

@section Styles {
    <link rel="stylesheet" href="~/css/classes/index.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/classes/index.js" asp-append-version="true"></script>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Lớp học</h1>
    <a asp-action="Create" class="btn btn-primary">Thêm lớp</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

<form asp-action="Index" method="get" class="classes-filter row g-2 align-items-end mb-3">
    <div class="col-md-4">
        <label asp-for="Filter.Search" class="form-label"></label>
        <input asp-for="Filter.Search" class="form-control" placeholder="Tìm theo tên hoặc mã lớp" />
    </div>
    <div class="col-md-3">
        <label asp-for="Filter.TeacherId" class="form-label"></label>
        <select asp-for="Filter.TeacherId" asp-items="Model.TeacherOptions" class="form-select">
            <option value="">Tất cả</option>
        </select>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-outline-primary">Search</button>
    </div>
</form>

@if (Model.Classes.Count == 0)
{
    <p class="text-muted">Không có lớp nào.</p>
}
else
{
    <table class="classes-table table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Mã lớp</th>
                <th>Tên lớp</th>
                <th>Giáo viên</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Classes)
            {
                <tr>
                    <td>@c.Id</td>
                    <td>@c.Code</td>
                    <td>@c.Name</td>
                    <td>@(c.Teacher is null ? "—" : $"{c.Teacher.FirstName} {c.Teacher.LastName}")</td>
                </tr>
            }
        </tbody>
    </table>

    <p class="text-muted">Tổng: @Model.Classes.Count</p>
}
