@model student_management_be_dotnet.Models.TeacherCreateViewModel

@{
    ViewData["Title"] = "Thêm lớp";
}

<h1>Thêm giáo viên</h1>

<form asp-action="Create" method="post"> 
    <div class=" form-grid">
        <div class="form-group">
        
            <label for="firstName">Họ *</label>
            <input id="firstName" name="firstName" type="text" placeholder="Nguyễn Minh" required>
        </div>

        <div class="form-group">
            <label for="lastName">Tên *</label>
            <input id="lastName" name="lastName" type="text" placeholder="Khoa" required>
        </div>

        <div class="form-group full">
            <label for="teacherCode">Mã giáo viên *</label>
            <input id="teacherCode" name="teacherCode" type="text" placeholder="GV005" required>
        </div>

        <div class="form-group">
            <label for="birthDate">Ngày sinh *</label>
            <input id="birthDate" name="birthDate" type="date" required>
        </div>

        <div class="form-group">
            <label for="gender">Giới tính</label>
            <select id="gender" name="gender">
                <option>Nam</option>
                <option>Nữ</option>
                <option>Khác</option>
            </select>
        </div>

        <div class="form-group">
            <label for="phone">Số điện thoại</label>
            <input id="phone" name="phone" type="tel" placeholder="0901 234 567">
        </div>

        <div class="form-group">
            <label for="email">Email *</label>
            <input id="email" name="email" type="email" placeholder="teacher@example.com" required>
        </div>

        <div class="form-group">
            <label for="subject">Môn dạy *</label>
            <select id="subject" name="subject" required>
                <option value="">-- Chọn môn --</option>
                <option>HTML/CSS</option>
                <option>JavaScript</option>
                <option>Git &amp; GitHub</option>
                <option>PHP</option>
            </select>
        </div>

        <div class="form-group">
            <label for="degree">Học vị</label>
            <select id="degree" name="degree">
                <option>Cử nhân</option>
                <option>Thạc sĩ</option>
                <option>Tiến sĩ</option>
            </select>
        </div>

        <div class="form-group full">
            <label for="startDate">Ngày bắt đầu giảng dạy</label>
            <input id="startDate" name="startDate" type="date">
        </div>

        <div class="form-group full">
            <label for="address">Địa chỉ</label>
            <textarea id="address" name="address" rows="3" placeholder="Nhập địa chỉ"></textarea>
        </div>
    </div>

    <div class="form-actions">
        <button class="button-light" type="button">
            Hủy
        </button>
        <button type="submit">Thêm giáo viên</button>
    </div>
</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
